# Supabase Project Configuration (Client & Public)
# Dapatkan dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Alias publishable key (opsional, backward compatible)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Production Site URL (untuk redirect callback OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog product analytics (opsional; tidak aktif jika token kosong)
# Ambil Project API Key dari Project Settings > Project Details.
# Ini adalah project token publik untuk browser, BUKAN Personal API Key.
# US Cloud ingestion host:
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your-posthog-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-Only Secrets (JANGAN PERNAH gunakan prefix NEXT_PUBLIC_!)
# Hanya diperlukan jika menjalankan background job atau migrasi administratif di server
# SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key-do-not-expose
